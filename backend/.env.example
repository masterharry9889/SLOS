# ── Server ─────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://slos:slos_dev_password@localhost:5432/slos

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── S3 / MinIO ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=slos-uploads
S3_FORCE_PATH_STYLE=true

# ── Agents Service ─────────────────────────────────────
AGENTS_SERVICE_URL=http://localhost:8000
AGENTS_SERVICE_KEY=change-me-agents-service-key

# ── HMAC (callback signature) ─────────────────────────
HMAC_SECRET=change-me-hmac-secret-at-least-32-chars

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Callback URL base (public URL of this backend) ────
CALLBACK_BASE_URL=http://localhost:3001

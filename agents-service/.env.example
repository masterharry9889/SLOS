# Service Port and Host
PORT=8000
HOST=0.0.0.0

# Service Authentication Key (must match backend's AGENTS_SERVICE_KEY)
X_SERVICE_KEY=change-me-agents-service-key

# LLM Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Vector Store / PostgreSQL Database URL (with pgvector)
DATABASE_URL=postgresql://slos:slos_dev_password@localhost:5432/slos

# Model Overrides (Optional - defaults to anthropic-default)
MODEL_PARSER=claude-3-5-sonnet-20241022
MODEL_NOTES=claude-3-5-sonnet-20241022
MODEL_ASSESS=claude-3-5-sonnet-20241022
MODEL_CHEATSHEET=claude-3-5-sonnet-20241022
MODEL_PAPER=claude-3-5-sonnet-20241022
MODEL_TUTOR=claude-3-5-sonnet-20241022
